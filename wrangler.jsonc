{
  "name": "asicara",
  "main": "worker2.js",
  "compatibility_date": "2025-04-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "xs",
      "database_id": "116d01f7-1ec5-41d8-a748-755255d3a9bb"
    },
    {
      "binding": "xs_userdatas",
      "database_name": "xs",
      "database_id": "116d01f7-1ec5-41d8-a748-755255d3a9bb"
    }
  ]
}
